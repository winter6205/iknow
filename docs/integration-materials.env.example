# iknow — integration materials (FILL PLACEHOLDERS)
# ------------------------------------------------
# Usage:
#   1. Copy to a local untracked file, e.g. `.env.local` or `~/.config/iknow/env`
#   2. Replace every <ANGLE_BRACKET> value
#   3. Never commit real secrets; this file only documents variable NAMES
#
# Load order (planned for M1/M2 code): process.env only — no secrets in git.

# =============================================================================
# A. Runtime mode
# =============================================================================

# deterministic = rule loop (current default, CI)
# llm           = real chat model with tool_calls (M2)
IKNOW_AGENT_MODE=<deterministic_or_llm>

# =============================================================================
# B. Chat / LLM (M2 — tool-calling model)
# =============================================================================

# Provider id used by future src/agent-loop/llm-provider.ts
# Examples to write: openai | anthropic | azure_openai | openai_compatible | local
IKNOW_LLM_PROVIDER=<provider_id>

# Base URL (leave empty for vendor default; required for openai_compatible / local)
IKNOW_LLM_BASE_URL=<https_api_base_or_empty>

# Model id (examples: gpt-4.1-mini | claude-sonnet-4 | qwen-plus | ...)
IKNOW_LLM_MODEL=<model_id>

# Auth: put the secret ONLY in the env var named below (value never in git)
# Variable NAME to read (do not paste the secret into this file if committing)
IKNOW_LLM_API_KEY_ENV=<NAME_OF_ENV_VAR_HOLDING_THE_KEY>

# Optional org/project headers
IKNOW_LLM_ORG_ID=<optional_org_id>
IKNOW_LLM_PROJECT_ID=<optional_project_id>

# Budgets
IKNOW_LLM_MAX_OUTPUT_TOKENS=<e.g._2048>
IKNOW_LLM_TIMEOUT_MS=<e.g._60000>
IKNOW_LLM_TEMPERATURE=<e.g._0_or_0.2>

# Tool protocol: openai_tools | anthropic_tools
IKNOW_LLM_TOOL_PROTOCOL=<openai_tools_or_anthropic_tools>

# =============================================================================
# C. Embeddings / vector arm (M1 — kb_retrieve vector list)
# =============================================================================

# off = keyword/overlap only (current)
# api | local = real embeddings
IKNOW_EMBEDDING_MODE=<off_or_api_or_local>

IKNOW_EMBEDDING_PROVIDER=<provider_id>
IKNOW_EMBEDDING_BASE_URL=<https_api_base_or_empty>
IKNOW_EMBEDDING_MODEL=<e.g._text-embedding-3-small_or_bge-m3>
IKNOW_EMBEDDING_API_KEY_ENV=<NAME_OF_ENV_VAR_HOLDING_THE_KEY>
IKNOW_EMBEDDING_DIMS=<e.g._1536_or_1024>
IKNOW_EMBEDDING_TIMEOUT_MS=<e.g._30000>

# Vector store for MVP
# memory = Float32 in-process (default for M1)
# later: pgvector | sqlite_vss
IKNOW_VECTOR_STORE=<memory>

# Optional path for cached embeddings of seed corpus
IKNOW_EMBEDDING_CACHE_PATH=<absolute_or_relative_cache_path>

# =============================================================================
# D. Eval / gates when models are live
# =============================================================================

# Keep CI on deterministic unless explicitly set
IKNOW_EVAL_AGENT_MODE=<deterministic_or_llm>
IKNOW_EVAL_SET_PATH=<path_to_eval-set_json>

# Soft cost gate (USD per sample, optional)
IKNOW_EVAL_MAX_COST_USD_PER_SAMPLE=<e.g._0.05>

# =============================================================================
# E. Network / compliance
# =============================================================================

# true if models must stay offline / intranet only
IKNOW_REQUIRE_OFFLINE=<true_or_false>

# Optional proxy
HTTPS_PROXY=<optional_proxy_url>
HTTP_PROXY=<optional_proxy_url>
NO_PROXY=<optional_no_proxy_list>

# =============================================================================
# F. Checklist (human)
# =============================================================================
# [ ] LLM provider + model confirmed for tool_calls
# [ ] Embedding provider + model + dims confirmed
# [ ] Secrets only in env vars named by *_API_KEY_ENV
# [ ] Offline constraint decided
# [ ] Willing to run paid smoke calls for M1 then M2
