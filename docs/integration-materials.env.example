# iknow — integration materials (FILL PLACEHOLDERS)
# ------------------------------------------------
# Usage:
#   1. Copy to a local untracked file, e.g. `.env.local` or `~/.config/iknow/env`
#   2. Replace every <ANGLE_BRACKET> value
#   3. Never commit real secrets; this file only documents variable NAMES
#
# Load order (planned for M1/M2 code): process.env only — no secrets in git.

# =============================================================================
# Deployment profile for this project: NETWORK API + API KEY (not local weights)
# =============================================================================
# - Keys live only in real env vars (or OS secret store), never in git.
# - This file documents NAMES and non-secret settings for you to fill.
# - Profile lock-in: offline/local model paths are out of scope unless you change this.

# =============================================================================
# A. Chat / LLM (remote tool-calling model over HTTPS)
# =============================================================================
#
# LLM 配置收敛到 settings.json 单承载（ADR-0015 settings-model-extension）:
#   - `~/.iknow/settings.json` (user) + `<cwd>/.iknow/settings.json` (project)
#     字段 `llm.model` (字面值, 唯一 model 来源) + `llm.apiKey` (字面 / ${VAR} 占位符)
#     + 可选 `llm.fallback: string[]` (用户自配 fallback 路由 ID 列表)。
#   - `IKNOW_LLM_API_KEY_ENV` / `IKNOW_LLM_MODEL` 已退役 (不再读取)；
#     `LlmEnv.apiKeyEnv` 字段已删。
#   - 占位符 `${VAR}` 解析从 process.env[VAR] > .env.local > .env 兜底；
#     本文件仍是占位符真值的载体 (例如 `ANTHROPIC_AUTH_TOKEN=<key>` 供 settings
#     `${ANTHROPIC_AUTH_TOKEN}` 解析)。绝不在 settings 文件 / fixtures / 源码 /
#     git / 日志中写真实密钥字面值。
#
# 保留的 env (provider / baseUrl 是项目级栈决策):
IKNOW_LLM_BASE_URL=<https_api_base_or_empty>

IKNOW_LLM_ORG_ID=<optional_or_empty>
IKNOW_LLM_PROJECT_ID=<optional_or_empty>

# Max tokens generated per completion (NOT the full context window)
IKNOW_LLM_MAX_OUTPUT_TOKENS=8192
IKNOW_LLM_TIMEOUT_MS=60000
IKNOW_LLM_TEMPERATURE=0

# C. Embeddings / vector arm — 已退役（023 归档 + 旧 loop 残留清理）；无 embedding env 被 loadIknowEnv 读取。

# =============================================================================
# D. Eval / gates when models are live
# =============================================================================

IKNOW_EVAL_SET_PATH=docs/iknow-spec/docs/eval/eval-set.draft.json
IKNOW_EVAL_MAX_COST_USD_PER_SAMPLE=<0.05_or_empty>

# =============================================================================
# E. Network (API profile)
# =============================================================================

# Must be false for network API + key profile
IKNOW_REQUIRE_OFFLINE=false

# Only if your network needs a proxy to reach the vendor
HTTPS_PROXY=<optional_or_empty>
HTTP_PROXY=<optional_or_empty>
NO_PROXY=<optional_or_empty>

# Outbound proxy for the ACI Web tools (web_fetch / web_search), aligned with
# upstream OPENHARNESS_WEB_PROXY. Explicit opt-in (trust_env=false semantics):
# empty -> direct connection (no dispatcher); set -> undici ProxyAgent routes
# the outbound fetch through this proxy (remote DNS + egress, bypasses local
# DNS poisoning / region blocks). Validated against the same URL syntax guard
# as targets (http/https, no embedded credentials); a local proxy (e.g.
# http://127.0.0.1:7897) is allowed. https targets go through CONNECT tunnel.
IKNOW_WEB_PROXY=<optional_http_proxy_url_or_empty>

# Optional HTML search endpoint override for web_search (private backend /
# testing / region-specific reachability). Empty -> default Bing
# (cn.bing.com/search). DuckDuckGo html (https://html.duckduckgo.com/html/)
# stays reachable via this override on networks where Bing is blocked.
IKNOW_WEB_SEARCH_URL=<optional_search_endpoint_or_empty>

# =============================================================================
# F. Checklist (human)
# =============================================================================
# [ ] LLM: remote API + tool_calls-capable model chosen
# [ ] settings.json `llm.model` / `llm.apiKey` (或 ${VAR} 占位符) 已配
# [ ] Real key 只存在于 env / OS secret store，绝不在本文件 / settings / git
# [ ] IKNOW_REQUIRE_OFFLINE=false
# [ ] Willing to pay for M1 then M2 smoke traffic
