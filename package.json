{
  "name": "iknow",
  "version": "0.1.0",
  "description": "Standalone agent harness (loop engine + Anthropic adapter + ACI 8-tool set) for a tool-calling LLM CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "iknow": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "aci:demo": "tsx src/harness/aci/demo.ts",
    "probe:sandbox": "tsx scripts/sandbox-probe.ts",
    "probe:lsp": "tsx scripts/lsp-probe.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^3.2.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-language-server": "^5.3.0",
    "vitest": "^3.2.7"
  },
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "smol-toml": "^1.7.1",
    "string-width": "^8.2.2",
    "undici": "^7.29.0",
    "vscode-jsonrpc": "^9.0.1",
    "wrap-ansi": "^8.1.0"
  }
}
