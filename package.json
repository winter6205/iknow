{
  "name": "iknow",
  "version": "0.1.0",
  "description": "Local coding agent: loop engine, sandboxed tools, CLI / TUI / web",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "iknow": "dist/cli.js",
    "iknow-trace-mcp": "scripts/iknow-trace-mcp.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:s5": "node $HOME/.claude/plugins/marketplaces/arthurpower-local/plugins/arthurpower/scripts/s5-complexity/check.mjs --changed",
    "lint:s5:staged": "node $HOME/.claude/plugins/marketplaces/arthurpower-local/plugins/arthurpower/scripts/s5-complexity/check.mjs --changed --staged",
    "lint:s5:all": "node $HOME/.claude/plugins/marketplaces/arthurpower-local/plugins/arthurpower/scripts/s5-complexity/check.mjs src",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run && bun test tests/tui/",
    "test:changed": "vitest run --changed",
    "test:pre-push": "vitest run --retry 1",
    "test:ci": "vitest run",
    "test:ci:fast": "vitest run --config vitest.ci-fast.config.ts",
    "test:ci:full": "vitest run --config vitest.ci.config.ts",
    "test:real-llm": "vitest run --config vitest.real-llm.config.ts",
    "ci:check-excludes": "tsx scripts/ci-check-test-excludes.ts",
    "probe:lsp": "tsx scripts/lsp-probe.ts",
    "probe:sandbox:subagent": "tsx scripts/sandbox-probe-subagent.ts",
    "probe:aci-web-backend": "tsx scripts/aci-web-backend-exa-probe.ts",
    "probe:role-substitution:sampling": "tsx scripts/role-substitution-sampling-probe.ts",
    "bench:transcript": "tsx scripts/bench-transcript-baseline.ts",
    "dev": "tsx src/cli.ts",
    "dev:tui": "bun run src/cli.ts tui",
    "dev:tui:auto-mode": "bun run src/cli.ts tui --auto-mode",
    "serve": "tsx src/cli.ts serve",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "aci:demo": "tsx src/harness/aci/demo.ts",
    "install:search-engine": "tsx scripts/install-search-engine.ts",
    "designs:tui-preview": "bun run scripts/tui-designs-preview.tsx",
    "worktree:gc": "tsx scripts/task-worktree-gc.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^3.2.7",
    "dockerfile-language-server-nodejs": "^0.15.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "pyright": "^1.1.411",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "typescript-language-server": "^5.3.0",
    "vitest": "^3.2.7",
    "vscode-json-languageserver": "^1.3.4",
    "yaml-language-server": "^1.24.0"
  },
  "private": true,
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.76",
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentui/core": "0.5.1",
    "@opentui/react": "0.5.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "diff": "^9.0.0",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "undici": "^7.29.0",
    "vscode-jsonrpc": "^9.0.1",
    "wrap-ansi": "^8.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.5.2"
  }
}
