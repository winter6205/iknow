{
  "name": "iknow",
  "version": "0.1.0",
  "description": "Standalone agent harness (loop engine + Anthropic adapter + ACI 8-tool set) for a tool-calling LLM CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "iknow": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && $HOME/.bun/bin/bun test tests/tui/",
    "test:changed": "vitest run --changed",
    "test:pre-push": "vitest run --retry 1",
    "test:ci": "vitest run",
    "test:real-llm": "vitest run --config vitest.real-llm.config.ts",
    "ci:check-excludes": "tsx scripts/ci-check-test-excludes.ts",
    "dev": "tsx src/cli.ts",
    "dev:tui": "$HOME/.bun/bin/bun run src/cli.ts tui",
    "dev:tui:auto-mode": "$HOME/.bun/bin/bun run src/cli.ts tui --auto-mode",
    "serve": "tsx src/cli.ts serve",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "aci:demo": "tsx src/harness/aci/demo.ts",
    "probe:sandbox": "tsx scripts/sandbox-probe.ts",
    "probe:sandbox:subagent": "tsx scripts/sandbox-probe-subagent.ts",
    "probe:lsp": "tsx scripts/lsp-probe.ts",
    "probe:tui-binding": "$HOME/.bun/bin/bun run scripts/tui-binding-probe.ts",
    "probe:t4-real-llm": "tsx scripts/t4-spawn-subagent-real-llm-smoke.ts",
    "probe:interrupt-transcript": "tsx scripts/i392-probe-b2-interrupt-transcript.ts",
    "designs:tui-preview": "bun run scripts/tui-designs-preview.tsx",
    "probe:settings-model": "tsx scripts/i135-settings-model-extension-smoke.ts",
    "probe:settings-bidir": "tsx scripts/i413-bidirectional-settings-smoke.ts",
    "probe:compact-events": "tsx scripts/probe-compact-events-548-550.ts",
    "probe:t8-popover": "tsx scripts/t8-popover-verify.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^3.2.7",
    "dockerfile-language-server-nodejs": "^0.15.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "pyright": "^1.1.411",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-language-server": "^5.3.0",
    "vitest": "^3.2.7",
    "vscode-json-languageserver": "^1.3.4",
    "yaml-language-server": "^1.24.0"
  },
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@opentui/core": "0.5.1",
    "@opentui/react": "0.5.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "diff": "^9.0.0",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "smol-toml": "^1.7.1",
    "string-width": "^8.2.2",
    "undici": "^7.29.0",
    "vscode-jsonrpc": "^9.0.1",
    "wrap-ansi": "^8.1.0"
  }
}
