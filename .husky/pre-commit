# git 会在钩子环境内自动注入 GIT_DIR / GIT_INDEX_FILE / GIT_WORK_TREE /
# GIT_COMMON_DIR,子进程(vitest 里那些自建临时 git repo 的测试,例如
# worktree-gate / hub-worktree-isolation / worktree-rebind / rebind-boundary-matrix)
# 会继承并污染它们的 init,导致
#   "invalid object ... for '.claude/settings.json'" / "index file open failed: Not a directory"
# 在独立运行时 vitest 全绿,只在钩子里稳态 38 fail。在钩子入口先 unset,
# 让子进程拿到的就是"普通 shell 环境"。
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_COMMON_DIR

npx lint-staged

# docs-only 快速路径：vitest --changed 只按"与 HEAD 有差异的代码文件"挑相关测试，
# staged diff 里一个代码文件都没有时（纯文档提交）它会退化成跑全量套件——5 个
# markdown 的提交实测耗几分钟。纯文档改动既不影响类型也不影响测试结果，
# typecheck + test:changed 没有可校验的对象，这里直接放行。
# Note: lint-staged (including Prettier formatting for Markdown) still runs above;
# quotePath=false prevents non-ASCII filenames from being escaped as
# "docs/\346\226\207..." 而漏判。git 失败时置空 → 退回全量路径（保守）。
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR) || staged=""
if [ -n "$staged" ]; then
  docs_only=1
  set -f # 关闭 glob，避免文件名被意外展开
  for f in $staged; do
    case "$f" in
      docs/*|specs/*) ;; # 文档/spec 目录下的任意文件
      */*) docs_only=0 ;; # 其余带目录的（含 src/tests/scripts/web 等代码）
      *.md) ;; # 仓库根部的 README.md / CHANGELOG.md 等
      *) docs_only=0 ;;
    esac
  done
  set +f
  if [ "$docs_only" = 1 ]; then
    echo "docs-only staged change: skipping typecheck + tests"
    exit 0
  fi
fi

npm run typecheck
# 只跑与本次变更相关的测试（vitest --changed 基于 git HEAD 差异）。
# 全量不在 commit 期跑（耗时长，CPU 争用下易偶发失败），交给 CI：
# test-fast 每次事件快子集，test-full 夜间全量兜底。
npm run test:changed
