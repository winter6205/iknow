{
  "autoMemoryEnabled": false,
  "autoCompactEnabled": true,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(wc:*)",
      "Bash(pwd:*)",
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(pnpm --version:*)",
      "Bash(bash scripts/*:*)",
      "Bash(./scripts/*:*)",
      "Bash(chmod +x scripts/*:*)",
      "Bash(tail:*)",
      "Bash(git add:*)",
      "Bash(sleep:*)",
      "Bash(git commit:*)",
      "Bash(npm run test:*)",
      "Bash(npm test)",
      "Bash(npm run typecheck:*)"
    ],
    "ask": ["Bash(pnpm:*)", "Bash(yarn:*)"],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf:*)",
      "Bash(chmod -R 777:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
