{
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp"]
    },
    "iknow-lsp": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "src/lsp-mcp/main.ts", "--root", "."]
    },
    "iknow-trace": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "src/trace-mcp/main.ts", "--trace-out", "trace"]
    }
  }
}
